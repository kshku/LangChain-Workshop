digraph HITL {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.3", ranksep="0.5", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF1F8", color="#17365D", fontcolor="#17365D", fontname="Helvetica", fontsize=11, penwidth=1.2, margin="0.14,0.08"];
  edge [color="#5B6B7C", fontcolor="#4A5A6A", fontname="Helvetica", fontsize=10, arrowsize=0.8];

  agent [label="Agent proposes\ntool call"];
  interrupt [label="Interrupt\ninterrupt_on", fillcolor="#17365D", fontcolor="#FFFFFF"];
  human [label="Human decision", fillcolor="#FFF4E5", color="#B5651D", fontcolor="#B5651D"];
  approve [label="approve"];
  edit [label="edit"];
  reject [label="reject"];
  respond [label="respond"];
  tool [label="Tool executes", fillcolor="#DCE9F5"];
  resume [label="Resume thread\nCommand(resume=...)"];

  agent -> interrupt -> human;
  human -> approve -> tool;
  human -> edit -> tool;
  human -> reject -> resume;
  human -> respond -> resume;
  tool -> resume -> agent;
}
