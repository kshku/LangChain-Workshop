digraph MCP {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.55", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fillcolor="#EAF1F8", color="#17365D", fontcolor="#17365D", fontname="Helvetica", fontsize=11, penwidth=1.2, margin="0.16,0.09"];
  edge [color="#5B6B7C", fontcolor="#4A5A6A", fontname="Helvetica", fontsize=10, arrowsize=0.8];

  agent [label="Deep agent"];
  adapter [label="MCPAdapter", fillcolor="#17365D", fontcolor="#FFFFFF"];
  server [label="MCP server\ndocs.langchain.com/mcp"];
  discovered [label="Discovered tools"];
  allowlist [label="Allowlist filter"];

  agent -> adapter [label="connect"];
  adapter -> server [label="list_tools()"];
  server -> discovered;
  discovered -> allowlist;
  allowlist -> agent [label="tools=[...]"];
}
